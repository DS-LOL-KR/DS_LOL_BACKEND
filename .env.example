NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://postgres:password@localhost:5432/ds_lol_dev"

# docker-compose의 db 서비스(Postgres 컨테이너) 생성용 — 위 DATABASE_URL의
# user/password/db 이름과 일치시켜야 함 (docker-compose.yml에서 DATABASE_URL을
# 이 값들로 재조립해서 컨테이너 내부 네트워크용 host(db)로 덮어씀).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=ds_lol_dev

JWT_SECRET=여기에_긴_랜덤_문자열
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

RIOT_API_KEY=RGAPI-xxxxxxxx
RIOT_REGION=kr

CORS_ORIGIN=http://localhost:5173

# 디스코드 슬래시 명령어(/티어표, /전적, /내전결과) 봇 (선택) — Discord Developer
# Portal(discord.com/developers/applications)에서 앱 생성 후 Bot 탭에서 토큰,
# General Information 탭에서 Application ID/Public Key를 발급받아 채움. 셋 다
# 비어있으면 /api/discord/interactions가 모든 요청을 401로 거부함(기능 자체는
# 꺼진 채로, 서버 기동엔 영향 없음).
# DISCORD_BOT_TOKEN=xxx
# DISCORD_APPLICATION_ID=xxx
# DISCORD_PUBLIC_KEY=xxx
# 개발 중 슬래시 명령어를 즉시 반영해서 테스트하고 싶은 서버의 길드 ID(선택) —
# scripts/registerDiscordCommands.ts가 이게 있으면 전역 등록(최대 1시간 소요)
# 대신 이 서버에만 즉시 등록함. 개발자 모드 켜고 서버 아이콘 우클릭 > "서버 ID 복사".
# DISCORD_TEST_GUILD_ID=xxx

# 프로필 이미지 저장소 (선택) — 4개(AWS_REGION/AWS_S3_BUCKET/AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY)를 전부 채워야 S3로 전환됨. 하나라도 비어있으면
# uploads/profile-images/ 로컬 디스크에 저장함(지금 기본값, 2026-09-09 기준
# 아직 AWS 계정 연결 전이라 비워둠).
# AWS_REGION=ap-northeast-2
# AWS_S3_BUCKET=ds-lol-uploads
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx
# CloudFront 등 커스텀 도메인을 쓰면 그 URL, 안 쓰면 비워두면 기본 S3 URL로 조합됨.
# AWS_S3_PUBLIC_URL=https://cdn.ds-lol.com
